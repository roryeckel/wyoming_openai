# Chatterbox TTS API for TTS; STT stays on the stack's Speaches. Free, local, on an NVIDIA GPU, since on the CPU
# its long replies time out; the first start downloads the model.
# Engine: docker compose -f tests/ha_e2e/live/docker-compose.engines.yml -f tests/ha_e2e/live/docker-compose.engines.gpu.yml
#   --profile chatterbox up -d --wait chatterbox-tts
# Serves: TTS over HTTP, sentence by sentence. STT stays on the stack's Speaches.
# Backend: OPENAI for TTS.
TTS_OPENAI_URL=http://chatterbox-tts:4123/v1
TTS_MODELS=tts-1-hd
TTS_STREAMING_MODELS=tts-1-hd
TTS_REALTIME_MODELS=
TTS_BACKEND=OPENAI
TTS_VOICES=default
