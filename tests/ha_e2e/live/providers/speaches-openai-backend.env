# The stack's own Speaches on the plain OPENAI backend for both sides, without the SPEACHES shim: a free way to run
# the code path every third-party OpenAI-compatible provider takes. No key, no engine to start.
# Serves: STT over HTTP, not streamed; TTS over HTTP, sentence by sentence.
# Backend: OPENAI for both.
STT_OPENAI_URL=http://speaches:8000/v1
STT_MODELS=Systran/faster-distil-whisper-large-v3
STT_STREAMING_MODELS=
STT_REALTIME_MODELS=
STT_BACKEND=OPENAI
TTS_OPENAI_URL=http://speaches:8000/v1
TTS_MODELS=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_STREAMING_MODELS=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_REALTIME_MODELS=
TTS_BACKEND=OPENAI
TTS_VOICES=af_heart am_michael
