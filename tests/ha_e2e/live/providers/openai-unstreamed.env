# Official OpenAI over HTTP, without streaming: /v1/audio/transcriptions answered whole, and /v1/audio/speech for
# each reply in one request. The other HTTP modes are in openai.env, Realtime in the OpenAI lane. Paid.
# Key: HA_LIVE_STT_KEY and HA_LIVE_TTS_KEY, an OpenAI API key.
# Serves: STT over HTTP, not streamed; TTS over HTTP, one request per reply.
# Backend: OPENAI for both.
STT_OPENAI_URL=https://api.openai.com/v1
STT_MODELS=gpt-4o-mini-transcribe
STT_STREAMING_MODELS=
STT_REALTIME_MODELS=
STT_BACKEND=OPENAI
TTS_OPENAI_URL=https://api.openai.com/v1
TTS_MODELS=gpt-4o-mini-tts
TTS_STREAMING_MODELS=
TTS_REALTIME_MODELS=
TTS_BACKEND=OPENAI
TTS_VOICES=
