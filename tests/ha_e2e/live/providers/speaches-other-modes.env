# The stack's own Speaches, with the SPEACHES shim, in the modes the local lane does not run: STT streamed and TTS in
# one request per reply. Free; no key, no engine to start.
# Serves: STT over HTTP, streamed; TTS over HTTP, one request per reply.
# Backend: SPEACHES for both.
STT_OPENAI_URL=http://speaches:8000/v1
STT_MODELS=
STT_STREAMING_MODELS=Systran/faster-distil-whisper-large-v3
STT_REALTIME_MODELS=
STT_BACKEND=SPEACHES
TTS_OPENAI_URL=http://speaches:8000/v1
TTS_MODELS=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_STREAMING_MODELS=
TTS_REALTIME_MODELS=
TTS_BACKEND=SPEACHES
TTS_VOICES=
