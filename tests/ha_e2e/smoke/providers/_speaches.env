# Not a provider: what every provider file starts from, the smoke stack's own Speaches for STT and TTS. A provider
# file that serves a side sets every variable of that side, so nothing of Speaches is left on it.
STT_OPENAI_URL=http://speaches:8000/v1
STT_MODELS=Systran/faster-distil-whisper-large-v3
STT_STREAMING_MODELS=
STT_REALTIME_MODELS=
STT_BACKEND=SPEACHES
TTS_OPENAI_URL=http://speaches:8000/v1
TTS_MODELS=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_STREAMING_MODELS=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_REALTIME_MODELS=
TTS_BACKEND=SPEACHES
TTS_VOICES=
