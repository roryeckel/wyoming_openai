# LocalAI for STT (Whisper) and TTS (Piper), with the LOCALAI shim, as in docker-compose.localai.yml. Free, local,
# on the GPU; the first start downloads the models.
# Engine: docker compose -f docker-compose.localai.yml up -d --wait localai init-localai
#   (wait for init-localai to exit, and docker compose -f docker-compose.localai.yml down afterwards)
# Backend: LOCALAI for both.
STT_OPENAI_URL=http://host.docker.internal:8080/v1
STT_MODELS=whisper-base
STT_STREAMING_MODELS=
STT_REALTIME_MODELS=
STT_BACKEND=LOCALAI
TTS_OPENAI_URL=http://host.docker.internal:8080/v1
TTS_MODELS=en-us-amy-low.onnx en-us-ryan-medium.onnx
TTS_STREAMING_MODELS=en-us-amy-low.onnx en-us-ryan-medium.onnx
TTS_REALTIME_MODELS=
TTS_BACKEND=LOCALAI
TTS_VOICES=
