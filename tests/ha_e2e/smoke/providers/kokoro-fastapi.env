# Kokoro-FastAPI for TTS, with the KOKORO_FASTAPI shim (voices listed from /audio/voices); STT stays on the stack's
# Speaches. Free, local, on the GPU.
# Engine: docker compose -f docker-compose.kokoro-fastapi.yml up -d --wait kokoro
#   (and docker compose -f docker-compose.kokoro-fastapi.yml down afterwards)
# Backend: KOKORO_FASTAPI for TTS.
TTS_OPENAI_URL=http://host.docker.internal:8880/v1
TTS_MODELS=kokoro
TTS_STREAMING_MODELS=kokoro
TTS_REALTIME_MODELS=
TTS_BACKEND=KOKORO_FASTAPI
TTS_VOICES=
