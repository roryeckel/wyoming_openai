# Not a provider: the fallback for the side a preset doesn't serve, the smoke stack's own Speaches. The provider lane
# loads it before the preset (docker-compose.provider.yml), so a preset that serves only TTS, for example, has its
# STT here. A preset that serves a side sets every variable of that side, so none of these is left on it.
STT_OPENAI_URL=http://speaches:8000/v1
STT_MODELS=Systran/faster-distil-whisper-large-v3
STT_STREAMING_MODELS=
STT_REALTIME_MODELS=
STT_BACKEND=SPEACHES
TTS_OPENAI_URL=http://speaches:8000/v1
TTS_MODELS=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_STREAMING_MODELS=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_REALTIME_MODELS=
TTS_BACKEND=SPEACHES
TTS_VOICES=
