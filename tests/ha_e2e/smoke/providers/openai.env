# Official OpenAI over HTTP: /v1/audio/transcriptions, streamed, and /v1/audio/speech, sentence by sentence.
# Realtime runs in the OpenAI lane (docker-compose.openai.yml). Paid.
# Key: SMOKE_STT_KEY and SMOKE_TTS_KEY, an OpenAI API key.
# Backend: OPENAI for both.
STT_OPENAI_URL=https://api.openai.com/v1
STT_MODELS=
STT_STREAMING_MODELS=gpt-transcribe
STT_REALTIME_MODELS=
STT_BACKEND=OPENAI
TTS_OPENAI_URL=https://api.openai.com/v1
TTS_MODELS=gpt-4o-mini-tts
TTS_STREAMING_MODELS=gpt-4o-mini-tts
TTS_REALTIME_MODELS=
TTS_BACKEND=OPENAI
TTS_VOICES=
