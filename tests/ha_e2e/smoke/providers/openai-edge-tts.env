# openai-edge-tts for TTS, as in docker-compose.openai-edge-tts.yml; STT stays on the stack's Speaches. Free; the
# engine runs locally but synthesizes through Microsoft Edge's online service.
# Engine: docker compose -f docker-compose.openai-edge-tts.yml up -d --wait openai-edge-tts
#   (and docker compose -f docker-compose.openai-edge-tts.yml down afterwards)
# Backend: OPENAI for TTS.
TTS_OPENAI_URL=http://host.docker.internal:5050/v1
TTS_MODELS=tts-1
TTS_STREAMING_MODELS=tts-1
TTS_REALTIME_MODELS=
TTS_BACKEND=OPENAI
TTS_VOICES=en-US-AvaNeural en-US-AndrewNeural
