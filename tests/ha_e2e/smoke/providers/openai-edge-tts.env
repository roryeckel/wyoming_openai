# openai-edge-tts for TTS; STT stays on the stack's Speaches. Free; the engine runs locally but synthesizes through
# Microsoft Edge's online service.
# Engine: docker compose -f tests/ha_e2e/smoke/docker-compose.engines.yml --profile openai-edge-tts up -d --wait openai-edge-tts
# Serves: TTS over HTTP, sentence by sentence. STT stays on the stack's Speaches.
# Backend: OPENAI for TTS.
TTS_OPENAI_URL=http://openai-edge-tts:5050/v1
TTS_MODELS=tts-1
TTS_STREAMING_MODELS=tts-1
TTS_REALTIME_MODELS=
TTS_BACKEND=OPENAI
TTS_VOICES=en-US-AvaNeural en-US-AndrewNeural
