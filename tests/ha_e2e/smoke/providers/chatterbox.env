# Chatterbox TTS API for TTS, as in docker-compose.chatterbox.yml; STT stays on the stack's Speaches. Free, local;
# the first start downloads the model.
# Engine: docker compose -f docker-compose.chatterbox.yml -f tests/ha_e2e/smoke/providers/chatterbox.gpu.yml \
#     up -d --wait chatterbox-tts
#   The second file puts the engine on the GPU; without it, it runs on the CPU, slowly enough for long replies to
#   time out. (And docker compose -f docker-compose.chatterbox.yml down afterwards)
# Serves: TTS over HTTP, sentence by sentence. STT stays on the stack's Speaches.
# Backend: OPENAI for TTS.
TTS_OPENAI_URL=http://host.docker.internal:4123/v1
TTS_MODELS=tts-1-hd
TTS_STREAMING_MODELS=tts-1-hd
TTS_REALTIME_MODELS=
TTS_BACKEND=OPENAI
TTS_VOICES=default
