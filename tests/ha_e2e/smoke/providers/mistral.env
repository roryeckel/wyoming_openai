# Mistral Voxtral for STT, as in docker-compose.voxtral.yml; TTS stays on the stack's Speaches. Paid.
# Key: SMOKE_STT_KEY, a Mistral API key.
# Serves: STT over HTTP, not streamed. TTS stays on the stack's Speaches.
# Backend: OPENAI for STT.
STT_OPENAI_URL=https://api.mistral.ai/v1
STT_MODELS=voxtral-mini-latest
STT_STREAMING_MODELS=
STT_REALTIME_MODELS=
STT_BACKEND=OPENAI
