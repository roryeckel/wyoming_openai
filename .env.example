STT_OPENAI_KEY=your_stt_openai_key_here
TTS_OPENAI_KEY=your_tts_openai_key_here
# Optional: bias speech-to-text toward the names Home Assistant exposes to Assist (administrator token)
# STT_HASS_TOKEN=your_home_assistant_long_lived_access_token
# STT_HASS_URL=http://homeassistant.local:8123
# Optional: add the transcript_names/transcript_terms a Wyoming client sends with transcribe to the STT prompt
# STT_TRANSCRIPT_NAMES=true
# Optional: room for those names in estimated tokens; keep the default 200 for Whisper, raise it for models with a
# longer context such as Qwen3-ASR, or set 0 to send every name
# STT_PROMPT_MAX_TOKENS=1000
